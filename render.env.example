# Copie para .env.local (nao commitar) ou configure no Render Dashboard.
# No Render: Environment -> Add from Database -> financas-db -> DATABASE_URL (Internal)

DJANGO_DEBUG=false
PYTHON_VERSION=3.12.4
ALLOWED_HOSTS=financaspessoais-eloo.onrender.com,.onrender.com
CSRF_TRUSTED_ORIGINS=https://financaspessoais-eloo.onrender.com
# Postgres (Render): copie External URL para render_db.url (gitignored) ou:
# DATABASE_URL=postgresql://... (External URL do financas-db no Render)
#
# Postgres local (sem DATABASE_URL):
# USE_POSTGRES=true
# POSTGRES_DB=SaudeFinanceiraPessoal
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=sua_senha
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# MedCloud (Medicinarte) — alternativa ao admin /admin/faturamento_medico/medcloudconfig/
# MEDCLOUD_RIS_USERNAME=
# MEDCLOUD_RIS_PASSWORD=
# MEDCLOUD_RIS_CLINIC_ID=
# MEDCLOUD_HIS_API_KEY=
# MEDCLOUD_RIS_BASE_URL=https://api.ris.medcloud.co
# MEDCLOUD_HIS_BASE_URL=https://his.medcloud.co/v1/his

# Conta Azul (por empresa — preferir /empresa/<id>/conta-azul/)
# CONTA_AZUL_CLIENT_ID=
# CONTA_AZUL_CLIENT_SECRET=
# CONTA_AZUL_REDIRECT_URI=https://financaspessoais-eloo.onrender.com/empresa/conta-azul/oauth/callback/
