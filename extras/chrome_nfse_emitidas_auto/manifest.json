{
  "manifest_version": 3,
  "name": "SaudeFinanceira — NFSe emitidas (automático)",
  "version": "1.0.0",
  "description": "Recebe período da app local e automatiza filtros e pedidos de XML/PDF na página oficial Notas emitidas do Emissor Nacional.",
  "key": "",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://www.nfse.gov.br/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.nfse.gov.br/EmissorNacional/Notas/Emitidas*"],
      "js": ["content_emitidas.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*",
      "http://[::1]/*"
    ]
  }
}
